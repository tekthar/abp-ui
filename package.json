{
  "name": "@abpjs/ui",
  "version": "0.2.0-next.16",
  "description": "The design system for ABP applications on Chakra UI v3 and React 19: tokens, recipes, the app shell, tables, lists, boards, forms and a settings frame. Names no product: the host gives its prefix, colours and words.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tekthar/abp-ui.git"
  },
  "homepage": "https://github.com/tekthar/abp-ui#readme",
  "bugs": {
    "url": "https://github.com/tekthar/abp-ui/issues"
  },
  "keywords": [
    "abp",
    "chakra-ui",
    "react",
    "design-system",
    "rtl"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "import": "./dist/rules.js",
      "default": "./dist/rules.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js",
      "default": "./dist/ai.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js",
      "default": "./dist/agent.js"
    },
    "./guard": {
      "types": "./dist/guard.d.ts",
      "import": "./dist/guard.js",
      "default": "./dist/guard.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "check:names": "node scripts/check-names.mjs"
  },
  "peerDependencies": {
    "@chakra-ui/react": ">=3.38.0 <4",
    "@emotion/react": "^11.14.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@chakra-ui/charts": "3.38.0",
    "@dagrejs/dagre": "3.1.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.52.0",
    "motion": "13.5.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@chakra-ui/react": "3.38.0",
    "@emotion/react": "11.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
